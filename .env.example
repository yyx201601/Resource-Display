# Use the pooled PostgreSQL connection string supplied by your Vercel storage integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# A separate, memorable code teachers enter to open /teacher-dashboard.
# Keep this server-only: do not prefix the name with NEXT_PUBLIC_.
TEACHER_DASHBOARD_CODE=replace-with-a-private-teacher-code

# A long random server-only value used to sign the 8-hour teacher session.
TEACHER_SESSION_SECRET=replace-with-a-long-random-secret
